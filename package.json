{
  "name": "filelens",
  "version": "1.0.0",
  "description": "🔍 Local Intelligent File Search Tool - Semantic search for your documents",
  "main": "frontend/main.js",
  "author": "FileLens Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd src && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "electron . --dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "electron-builder",
    "build:backend": "pyinstaller --onefile --name filelens-backend src/main.py",
    "test": "pytest tests/ -v",
    "lint": "flake8 src/ && black --check src/",
    "format": "black src/"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "build": {
    "appId": "com.filelens.app",
    "productName": "FileLens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "assets/**/*",
      "src/dist/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office"
    }
  }
}
